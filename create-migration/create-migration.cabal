cabal-version:      3.0
name:               create-migration
version:            0.2.0.0
synopsis:           Create sqitch changes from templates for safe Postgres migrations
description:
  A wrapper around @sqitch add@ that picks a template, asks for (or takes on the
  command line) the variables it needs, names the change consistently, and can
  emit several changes for multi-step migrations.
homepage:           https://github.com/kronor-io/sqitch-with-templates#readme
bug-reports:        https://github.com/kronor-io/sqitch-with-templates/issues
author:             Kronor Team
maintainer:         dev@kronor.io
copyright:          2021-2026 Kronor
license:            LGPL-3.0-or-later
category:           Development, Database
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md
data-files:         templates/**/*.tmpl
-- extra-source-files:

common warnings
    ghc-options: -Wall -Wcompat

source-repository head
  type:     git
  location: https://github.com/kronor-io/sqitch-with-templates

executable create-migration
  import:           warnings
  main-is:          Main.hs

  -- cabal-fmt: expand app -Main
  other-modules:
    Completion
    Paths_create_migration
    ProgramOptions
    Prompt
    Sqitch.Command
    Sqitch.Template
    SqitchConf

  autogen-modules:  Paths_create_migration

  hs-source-dirs:   app
  build-depends:
      base                  >=4.19.1.0     && < 4.22,
      containers >= 0.6.8 && < 0.9,
      directory >= 1.3.8 && < 1.4,
      filepath >= 1.4.200 && < 1.6,
      haskeline >= 0.8.2 && < 0.9,
      time >= 1.12.2 && < 1.16,
      optparse-applicative >= 0.19.0 && < 0.20,
      text >= 2.1.1 && < 2.2,
      process >= 1.6.18 && < 1.7,
      string-interpolate >= 0.3.4 && < 0.4,

  default-language: GHC2021
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    LambdaCase
    OverloadedRecordDot
    OverloadedStrings
    QuasiQuotes
