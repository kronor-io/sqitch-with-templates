-- Deploy [% project %]:[% change %] to [% engine %]

do $$

declare
    created_at_ timestamptz = '2020-01-01';
    last_created_at_ timestamptz = null;
begin

    -- MUST be session-scoped (is_local => false): the loop COMMITs, which discards
    -- SET LOCAL / set_config(.., true), leaving later batches on cluster defaults.
    -- Do not change these back to SET LOCAL.
    perform set_config('synchronous_commit', 'remote_apply', false);
    perform set_config('lock_timeout', '50ms', false);

    loop
        with to_be_updated as (
           select *
           from [% schema %].[% table_name %]
           -- the `>=` on created_at terminates only if the condition after
           -- the `and` clause does
           where [% table_name %].created_at >= created_at_
             and -- verify that column hasn't been updated already
           order by [% table_name %].created_at asc
           limit 100
           for update
        ), updates as (
           update [% schema %].[% table_name %]
              set -- assign some value to some column
           from to_be_updated
           where [% table_name %].id = to_be_updated.id
             and [% table_name %].merchant_id = to_be_updated.merchant_id
        )
        select max(to_be_updated.created_at) into last_created_at_ from to_be_updated;

        exit when last_created_at_ is null;

        created_at_ := last_created_at_;
        last_created_at_ := null;

        commit; -- don't sleep with locks taken

        raise info 'sleeping, updated rows up until created_at = %', created_at_;

        -- give waiting transactions a chance between batches
        perform pg_sleep(1);
    end loop;

    -- After inserting many rows, ANALYZE the target table:
    -- analyze [% schema %].[% table_name %];

    if last_created_at_ is null then
        raise info '"[% schema %].[% table_name %]" successfully updated';
    else
        raise exception 'failed to update data in "[% schema %].[% table_name %]"';
    end if;

end
$$;
